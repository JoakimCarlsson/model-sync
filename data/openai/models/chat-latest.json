{
  "id": "chat-latest",
  "provider": "openai",
  "name": "Chat Latest",
  "kind": "chat",
  "prices": [
    {
      "metric": "cached_input_tokens",
      "unit": "per_1m_tokens",
      "amount": 0.5,
      "currency": "USD",
      "dims": {
        "tier": "standard"
      }
    },
    {
      "metric": "input_tokens",
      "unit": "per_1m_tokens",
      "amount": 5,
      "currency": "USD",
      "dims": {
        "tier": "standard"
      }
    },
    {
      "metric": "output_tokens",
      "unit": "per_1m_tokens",
      "amount": 30,
      "currency": "USD",
      "dims": {
        "tier": "standard"
      }
    }
  ],
  "attrs": {
    "default_snapshot": "chat-latest",
    "knowledge_cutoff": "Aug 31, 2025",
    "summary": "Latest Instant model used in ChatGPT"
  },
  "limits": {
    "context_window": 400000,
    "max_input_tokens": 272000,
    "max_output_tokens": 128000
  },
  "lists": {
    "endpoints": [
      "v1/chat/completions",
      "v1/responses"
    ],
    "features": [
      "function_calling",
      "image_input",
      "streaming",
      "structured_outputs"
    ],
    "input_modalities": [
      "image",
      "text"
    ],
    "output_modalities": [
      "text"
    ],
    "snapshots": [
      "chat-latest"
    ],
    "tools": [
      "code_interpreter",
      "file_search",
      "function_calling",
      "image_generation",
      "mcp",
      "web_search"
    ]
  },
  "sources": [
    "https://developers.openai.com/api/docs/models/chat-latest.md",
    "https://developers.openai.com/api/docs/pricing.md"
  ]
}
