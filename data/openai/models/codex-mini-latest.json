{
  "id": "codex-mini-latest",
  "provider": "openai",
  "name": "codex-mini-latest",
  "kind": "chat",
  "prices": [
    {
      "metric": "cached_input_tokens",
      "unit": "per_1m_tokens",
      "amount": 0.375,
      "currency": "USD",
      "dims": {
        "tier": "standard"
      }
    },
    {
      "metric": "input_tokens",
      "unit": "per_1m_tokens",
      "amount": 1.5,
      "currency": "USD",
      "dims": {
        "tier": "standard"
      }
    },
    {
      "metric": "output_tokens",
      "unit": "per_1m_tokens",
      "amount": 6,
      "currency": "USD",
      "dims": {
        "tier": "standard"
      }
    }
  ],
  "attrs": {
    "default_snapshot": "codex-mini-latest",
    "knowledge_cutoff": "Jun 01, 2024",
    "summary": "Fast reasoning model optimized for the Codex CLI"
  },
  "limits": {
    "context_window": 200000,
    "max_output_tokens": 100000
  },
  "lists": {
    "endpoints": [
      "v1/responses"
    ],
    "features": [
      "evals",
      "function_calling",
      "image_input",
      "prompt_caching",
      "reasoning",
      "stored_completions",
      "streaming",
      "structured_outputs"
    ],
    "input_modalities": [
      "image",
      "text"
    ],
    "output_modalities": [
      "text"
    ],
    "snapshots": [
      "codex-mini-latest"
    ]
  },
  "sources": [
    "https://developers.openai.com/api/docs/models/codex-mini-latest.md"
  ]
}
