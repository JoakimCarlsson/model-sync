{
  "id": "gpt-5.1-codex-max",
  "provider": "openai",
  "name": "GPT-5.1-Codex-Max",
  "kind": "chat",
  "prices": [
    {
      "metric": "cached_input_tokens",
      "unit": "per_1m_tokens",
      "amount": 0.125,
      "currency": "USD",
      "dims": {
        "tier": "standard"
      }
    },
    {
      "metric": "input_tokens",
      "unit": "per_1m_tokens",
      "amount": 1.25,
      "currency": "USD",
      "dims": {
        "tier": "standard"
      }
    },
    {
      "metric": "output_tokens",
      "unit": "per_1m_tokens",
      "amount": 10,
      "currency": "USD",
      "dims": {
        "tier": "standard"
      }
    }
  ],
  "attrs": {
    "default_snapshot": "gpt-5.1-codex-max",
    "knowledge_cutoff": "2024-09-30",
    "recommended_replacement": "gpt-5.6-sol",
    "shutdown_date": "2026-07-23",
    "state": "shutdown",
    "summary": "A version of GPT-5.1-codex optimized for long running tasks."
  },
  "limits": {
    "context_window": 400000,
    "max_output_tokens": 128000
  },
  "lists": {
    "endpoints": [
      "v1/responses"
    ],
    "features": [
      "function_calling",
      "prompt_caching",
      "reasoning",
      "streaming",
      "structured_outputs",
      "web_search"
    ],
    "input_modalities": [
      "image",
      "text"
    ],
    "output_modalities": [
      "text"
    ],
    "snapshots": [
      "gpt-5.1-codex-max"
    ],
    "tools": [
      "function_calling",
      "web_search"
    ]
  },
  "sources": [
    "https://developers.openai.com/api/docs/deprecations.md",
    "https://developers.openai.com/api/docs/models/gpt-5.1-codex-max.md"
  ]
}
