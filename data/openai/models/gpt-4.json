{
  "id": "gpt-4",
  "provider": "openai",
  "name": "GPT-4",
  "kind": "chat",
  "prices": [
    {
      "metric": "input_tokens",
      "unit": "per_1m_tokens",
      "amount": 30,
      "currency": "USD",
      "dims": {
        "tier": "standard"
      }
    },
    {
      "metric": "output_tokens",
      "unit": "per_1m_tokens",
      "amount": 60,
      "currency": "USD",
      "dims": {
        "tier": "standard"
      }
    }
  ],
  "attrs": {
    "default_snapshot": "gpt-4-0613",
    "knowledge_cutoff": "Dec 01, 2023",
    "summary": "An older high-intelligence GPT model"
  },
  "limits": {
    "context_window": 8192,
    "max_output_tokens": 8192
  },
  "lists": {
    "endpoints": [
      "v1/assistants",
      "v1/batch",
      "v1/chat/completions",
      "v1/fine-tuning",
      "v1/responses"
    ],
    "features": [
      "fine_tuning",
      "streaming"
    ],
    "input_modalities": [
      "text"
    ],
    "output_modalities": [
      "text"
    ],
    "snapshots": [
      "gpt-4-0314",
      "gpt-4-0613"
    ]
  },
  "sources": [
    "https://developers.openai.com/api/docs/models/gpt-4.md"
  ]
}
