{
  "id": "o1-mini",
  "provider": "openai",
  "name": "o1-mini",
  "kind": "chat",
  "prices": [
    {
      "metric": "input_tokens",
      "unit": "per_1m_tokens",
      "amount": 1.1,
      "currency": "USD",
      "dims": {
        "tier": "standard"
      }
    },
    {
      "metric": "cached_input_tokens",
      "unit": "per_1m_tokens",
      "amount": 0.55,
      "currency": "USD",
      "dims": {
        "tier": "standard"
      }
    },
    {
      "metric": "output_tokens",
      "unit": "per_1m_tokens",
      "amount": 4.4,
      "currency": "USD",
      "dims": {
        "tier": "standard"
      }
    }
  ],
  "attrs": {
    "default_snapshot": "o1-mini-2024-09-12",
    "knowledge_cutoff": "Oct 01, 2023",
    "summary": "A small model alternative to o1"
  },
  "limits": {
    "context_window": 128000,
    "max_output_tokens": 65536
  },
  "lists": {
    "endpoints": [
      "v1/chat/completions",
      "v1/assistants"
    ],
    "features": [
      "reasoning",
      "streaming",
      "file_search",
      "file_uploads"
    ],
    "input_modalities": [
      "text"
    ],
    "output_modalities": [
      "text"
    ],
    "snapshots": [
      "o1-mini-2024-09-12"
    ],
    "tools": [
      "file_search",
      "code_interpreter",
      "mcp"
    ]
  },
  "sources": [
    "https://developers.openai.com/api/docs/models/o1-mini.md"
  ]
}
