{
  "id": "gpt-5.1-chat-latest",
  "provider": "openai",
  "name": "GPT-5.1 Chat",
  "kind": "chat",
  "prices": [
    {
      "metric": "cached_input_tokens",
      "unit": "per_1m_tokens",
      "amount": 0.125,
      "currency": "USD",
      "dims": {
        "tier": "standard"
      }
    },
    {
      "metric": "input_tokens",
      "unit": "per_1m_tokens",
      "amount": 1.25,
      "currency": "USD",
      "dims": {
        "tier": "standard"
      }
    },
    {
      "metric": "output_tokens",
      "unit": "per_1m_tokens",
      "amount": 10,
      "currency": "USD",
      "dims": {
        "tier": "standard"
      }
    }
  ],
  "attrs": {
    "default_snapshot": "gpt-5.1-chat-latest",
    "knowledge_cutoff": "2024-09-30",
    "recommended_replacement": "gpt-5.6-sol",
    "shutdown_date": "2026-07-23",
    "state": "shutdown",
    "summary": "GPT-5.1 model used in ChatGPT"
  },
  "limits": {
    "context_window": 128000,
    "max_input_tokens": 272000,
    "max_output_tokens": 16384
  },
  "lists": {
    "endpoints": [
      "v1/chat/completions",
      "v1/responses"
    ],
    "features": [
      "function_calling",
      "streaming",
      "structured_outputs"
    ],
    "input_modalities": [
      "image",
      "text"
    ],
    "output_modalities": [
      "text"
    ],
    "snapshots": [
      "gpt-5.1-chat-latest"
    ],
    "tools": [
      "code_interpreter",
      "file_search",
      "function_calling",
      "image_generation",
      "mcp",
      "web_search"
    ]
  },
  "sources": [
    "https://developers.openai.com/api/docs/deprecations.md",
    "https://developers.openai.com/api/docs/models/gpt-5.1-chat-latest.md"
  ]
}
