{
  "id": "gpt-oss-20b",
  "provider": "openai",
  "name": "gpt-oss-20b",
  "kind": "chat",
  "attrs": {
    "default_snapshot": "gpt-oss-20b",
    "knowledge_cutoff": "2024-06-01",
    "state": "active",
    "summary": "Medium-sized open-weight model for low latency"
  },
  "limits": {
    "context_window": 131072,
    "max_output_tokens": 131072
  },
  "lists": {
    "endpoints": [
      "v1/batch",
      "v1/responses"
    ],
    "features": [
      "function_calling",
      "reasoning",
      "streaming",
      "structured_outputs"
    ],
    "input_modalities": [
      "text"
    ],
    "output_modalities": [
      "text"
    ],
    "snapshots": [
      "gpt-oss-20b"
    ],
    "tools": [
      "code_interpreter",
      "function_calling",
      "mcp",
      "web_search"
    ]
  },
  "sources": [
    "https://developers.openai.com/api/docs/models/gpt-oss-20b.md"
  ]
}
