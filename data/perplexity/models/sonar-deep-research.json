{
  "id": "sonar-deep-research",
  "provider": "perplexity",
  "name": "Sonar Deep Research",
  "kind": "chat",
  "prices": [
    {
      "metric": "citation_tokens",
      "unit": "per_1m_tokens",
      "amount": 2,
      "currency": "USD"
    },
    {
      "metric": "input_tokens",
      "unit": "per_1m_tokens",
      "amount": 2,
      "currency": "USD"
    },
    {
      "metric": "output_tokens",
      "unit": "per_1m_tokens",
      "amount": 8,
      "currency": "USD"
    },
    {
      "metric": "reasoning_tokens",
      "unit": "per_1m_tokens",
      "amount": 3,
      "currency": "USD"
    },
    {
      "metric": "search_queries",
      "unit": "per_1k_requests",
      "amount": 5,
      "currency": "USD"
    }
  ],
  "attrs": {
    "recommended_replacement": "high preset",
    "retirement_date": "2026-09-27",
    "state": "legacy"
  },
  "limits": {
    "context_window": 128000,
    "max_output_tokens": 128000,
    "requests_per_minute_tier_0": 5,
    "requests_per_minute_tier_1": 10,
    "requests_per_minute_tier_2": 20,
    "requests_per_minute_tier_3": 40,
    "requests_per_minute_tier_4": 60,
    "requests_per_minute_tier_5": 100
  },
  "lists": {
    "endpoints": [
      "/v1/async/sonar",
      "/v1/sonar"
    ],
    "features": [
      "reasoning",
      "streaming",
      "structured_outputs"
    ],
    "input_modalities": [
      "file",
      "image",
      "text"
    ],
    "output_modalities": [
      "text"
    ],
    "parameters": [
      "disable_search",
      "enable_search_classifier",
      "image_domain_filter",
      "image_format_filter",
      "language_preference",
      "last_updated_after_filter",
      "last_updated_before_filter",
      "max_tokens",
      "messages",
      "model",
      "reasoning_effort",
      "response_format",
      "return_images",
      "return_related_questions",
      "search_after_date_filter",
      "search_before_date_filter",
      "search_domain_filter",
      "search_language_filter",
      "search_mode",
      "search_recency_filter",
      "stop",
      "stream",
      "stream_mode",
      "temperature",
      "top_p",
      "web_search_options"
    ],
    "reasoning_effort_levels": [
      "high",
      "low",
      "medium",
      "minimal"
    ],
    "search_modes": [
      "academic",
      "sec",
      "web"
    ]
  },
  "sources": [
    "https://docs.perplexity.ai/api-reference/async-sonar-post.md",
    "https://docs.perplexity.ai/api-reference/sonar-post.md",
    "https://docs.perplexity.ai/docs/admin/rate-limits-usage-tiers.md",
    "https://docs.perplexity.ai/docs/agent-api/migrate-from-sonar/overview.md",
    "https://docs.perplexity.ai/docs/sonar/features.md",
    "https://docs.perplexity.ai/docs/sonar/media.md",
    "https://docs.perplexity.ai/docs/sonar/models/sonar-deep-research.md",
    "https://docs.perplexity.ai/getting-started/pricing.md"
  ]
}
