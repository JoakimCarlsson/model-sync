{
  "id": "sonar-deep-research",
  "provider": "perplexity",
  "name": "Sonar Deep Research",
  "kind": "chat",
  "prices": [
    {
      "metric": "citation_tokens",
      "unit": "per_1m_tokens",
      "amount": 2,
      "currency": "USD"
    },
    {
      "metric": "input_tokens",
      "unit": "per_1m_tokens",
      "amount": 2,
      "currency": "USD"
    },
    {
      "metric": "output_tokens",
      "unit": "per_1m_tokens",
      "amount": 8,
      "currency": "USD"
    },
    {
      "metric": "reasoning_tokens",
      "unit": "per_1m_tokens",
      "amount": 3,
      "currency": "USD"
    },
    {
      "metric": "search_queries",
      "unit": "per_1k_requests",
      "amount": 5,
      "currency": "USD"
    }
  ],
  "limits": {
    "context_window": 128000,
    "max_output_tokens": 128000
  },
  "lists": {
    "features": [
      "reasoning",
      "streaming",
      "structured_outputs"
    ],
    "input_modalities": [
      "file",
      "image",
      "text"
    ],
    "output_modalities": [
      "text"
    ]
  },
  "sources": [
    "https://docs.perplexity.ai/api-reference/sonar-post.md",
    "https://docs.perplexity.ai/docs/sonar/features.md",
    "https://docs.perplexity.ai/docs/sonar/media.md",
    "https://docs.perplexity.ai/docs/sonar/models/sonar-deep-research.md",
    "https://docs.perplexity.ai/getting-started/pricing.md"
  ]
}
