{
  "id": "qwen2",
  "provider": "ollama",
  "kind": "chat",
  "attrs": {
    "summary": "Qwen2 is a new series of large language models from Alibaba group"
  },
  "limits": {
    "context_window": 32000
  },
  "lists": {
    "features": [
      "function_calling",
      "structured_outputs"
    ],
    "input_modalities": [
      "text"
    ],
    "output_modalities": [
      "text"
    ],
    "parameter_sizes": [
      "0.5b",
      "1.5b",
      "72b",
      "7b"
    ]
  },
  "sources": [
    "https://docs.ollama.com/capabilities/structured-outputs.md",
    "https://ollama.com/library",
    "https://ollama.com/library/qwen2/tags"
  ]
}
