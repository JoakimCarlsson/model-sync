{
  "id": "meditron",
  "provider": "ollama",
  "kind": "chat",
  "attrs": {
    "summary": "Open-source medical large language model adapted from Llama 2 to the medical domain."
  },
  "limits": {
    "context_window": 2000
  },
  "lists": {
    "features": [
      "structured_outputs"
    ],
    "input_modalities": [
      "text"
    ],
    "output_modalities": [
      "text"
    ],
    "parameter_sizes": [
      "70b",
      "7b"
    ]
  },
  "sources": [
    "https://docs.ollama.com/capabilities/structured-outputs.md",
    "https://ollama.com/library",
    "https://ollama.com/library/meditron/tags"
  ]
}
