{
  "id": "muse-glimmer",
  "provider": "ollama",
  "kind": "chat",
  "attrs": {
    "summary": "Meta&#39;s latest open model built for always-on local agents. 30B parameters, licensed under Apache 2.0 and runs on a single GPU — tuned for tool use, long tasks, and failure recovery."
  },
  "limits": {
    "context_window": 128000
  },
  "lists": {
    "features": [
      "function_calling",
      "reasoning"
    ],
    "input_modalities": [
      "image",
      "text"
    ],
    "output_modalities": [
      "text"
    ],
    "parameter_sizes": [
      "30b"
    ]
  },
  "sources": [
    "https://ollama.com/library",
    "https://ollama.com/library/muse-glimmer/tags"
  ]
}
