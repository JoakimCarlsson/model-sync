{
  "id": "stablelm-zephyr",
  "provider": "ollama",
  "kind": "chat",
  "attrs": {
    "summary": "A lightweight chat model allowing accurate, and responsive output without requiring high-end hardware."
  },
  "limits": {
    "context_window": 4000
  },
  "lists": {
    "features": [
      "structured_outputs"
    ],
    "input_modalities": [
      "text"
    ],
    "output_modalities": [
      "text"
    ],
    "parameter_sizes": [
      "3b"
    ]
  },
  "sources": [
    "https://docs.ollama.com/capabilities/structured-outputs.md",
    "https://ollama.com/library",
    "https://ollama.com/library/stablelm-zephyr/tags"
  ]
}
