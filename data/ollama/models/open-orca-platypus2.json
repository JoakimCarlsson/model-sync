{
  "id": "open-orca-platypus2",
  "provider": "ollama",
  "kind": "chat",
  "attrs": {
    "summary": "Merge of the Open Orca OpenChat model and the Garage-bAInd Platypus 2 model. Designed for chat and code generation."
  },
  "limits": {
    "context_window": 4000
  },
  "lists": {
    "features": [
      "structured_outputs"
    ],
    "input_modalities": [
      "text"
    ],
    "output_modalities": [
      "text"
    ],
    "parameter_sizes": [
      "13b"
    ]
  },
  "sources": [
    "https://docs.ollama.com/capabilities/structured-outputs.md",
    "https://ollama.com/library",
    "https://ollama.com/library/open-orca-platypus2/tags"
  ]
}
