{
  "id": "mistral-large-3",
  "provider": "ollama",
  "kind": "chat",
  "attrs": {
    "summary": "A general-purpose multimodal mixture-of-experts model for production-grade tasks and enterprise workloads."
  },
  "limits": {
    "context_window": 256000
  },
  "lists": {
    "features": [
      "function_calling",
      "structured_outputs"
    ],
    "input_modalities": [
      "image",
      "text"
    ],
    "output_modalities": [
      "text"
    ]
  },
  "sources": [
    "https://docs.ollama.com/capabilities/structured-outputs.md",
    "https://ollama.com/library",
    "https://ollama.com/library/mistral-large-3/tags"
  ]
}
