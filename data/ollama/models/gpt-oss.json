{
  "id": "gpt-oss",
  "provider": "ollama",
  "kind": "chat",
  "attrs": {
    "architecture": "gptoss",
    "cloud": "true",
    "default_snapshot": "gpt-oss:latest",
    "last_updated": "2025-10-09",
    "license": "Apache License 2.0",
    "open_weights": "true",
    "parameter_count": "20.9B",
    "quantization": "MXFP4",
    "summary": "OpenAI’s open-weight models designed for powerful reasoning, agentic tasks, and versatile developer use cases."
  },
  "limits": {
    "context_window": 128000
  },
  "lists": {
    "features": [
      "function_calling",
      "reasoning",
      "structured_outputs"
    ],
    "input_modalities": [
      "text"
    ],
    "output_modalities": [
      "text"
    ],
    "parameter_sizes": [
      "120b",
      "20b"
    ]
  },
  "sources": [
    "https://docs.ollama.com/capabilities/structured-outputs.md",
    "https://ollama.com/library",
    "https://ollama.com/library/gpt-oss/tags",
    "https://ollama.com/library/gpt-oss:latest"
  ]
}
