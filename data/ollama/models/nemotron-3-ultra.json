{
  "id": "nemotron-3-ultra",
  "provider": "ollama",
  "kind": "chat",
  "attrs": {
    "cloud": "true",
    "summary": "NVIDIA Nemotron 3 Ultra is built for high-throughput reasoning and long-running agent workflows.",
    "usage_level": "high",
    "usage_level_rank": "3"
  },
  "limits": {
    "context_window": 256000
  },
  "lists": {
    "features": [
      "function_calling",
      "reasoning",
      "structured_outputs"
    ],
    "input_modalities": [
      "text"
    ],
    "output_modalities": [
      "text"
    ]
  },
  "sources": [
    "https://docs.ollama.com/capabilities/structured-outputs.md",
    "https://ollama.com/library",
    "https://ollama.com/library/nemotron-3-ultra",
    "https://ollama.com/library/nemotron-3-ultra/tags"
  ]
}
