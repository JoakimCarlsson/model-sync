{
  "id": "opencoder",
  "provider": "ollama",
  "kind": "chat",
  "attrs": {
    "summary": "OpenCoder is an open and reproducible code LLM family which includes 1.5B and 8B models, supporting chat in English and Chinese languages."
  },
  "limits": {
    "context_window": 8000
  },
  "lists": {
    "features": [
      "structured_outputs"
    ],
    "input_modalities": [
      "text"
    ],
    "output_modalities": [
      "text"
    ],
    "parameter_sizes": [
      "1.5b",
      "8b"
    ]
  },
  "sources": [
    "https://docs.ollama.com/capabilities/structured-outputs.md",
    "https://ollama.com/library",
    "https://ollama.com/library/opencoder/tags"
  ]
}
