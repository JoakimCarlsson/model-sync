{
  "id": "codellama",
  "provider": "ollama",
  "kind": "chat",
  "attrs": {
    "summary": "A large language model that can use text prompts to generate and discuss code."
  },
  "limits": {
    "context_window": 16000
  },
  "lists": {
    "features": [
      "structured_outputs"
    ],
    "input_modalities": [
      "text"
    ],
    "output_modalities": [
      "text"
    ],
    "parameter_sizes": [
      "13b",
      "34b",
      "70b",
      "7b"
    ]
  },
  "sources": [
    "https://docs.ollama.com/capabilities/structured-outputs.md",
    "https://ollama.com/library",
    "https://ollama.com/library/codellama/tags"
  ]
}
