{
  "id": "moondream",
  "provider": "ollama",
  "kind": "chat",
  "attrs": {
    "summary": "moondream2 is a small vision language model designed to run efficiently on edge devices."
  },
  "limits": {
    "context_window": 2000
  },
  "lists": {
    "features": [
      "structured_outputs"
    ],
    "input_modalities": [
      "image",
      "text"
    ],
    "output_modalities": [
      "text"
    ],
    "parameter_sizes": [
      "1.8b"
    ]
  },
  "sources": [
    "https://docs.ollama.com/capabilities/structured-outputs.md",
    "https://ollama.com/library",
    "https://ollama.com/library/moondream/tags"
  ]
}
