{
  "id": "gemma3",
  "provider": "ollama",
  "kind": "chat",
  "attrs": {
    "summary": "The current, most capable model that runs on a single GPU."
  },
  "limits": {
    "context_window": 128000
  },
  "lists": {
    "features": [
      "structured_outputs"
    ],
    "input_modalities": [
      "image",
      "text"
    ],
    "output_modalities": [
      "text"
    ],
    "parameter_sizes": [
      "12b",
      "1b",
      "270m",
      "27b",
      "4b"
    ]
  },
  "sources": [
    "https://docs.ollama.com/capabilities/structured-outputs.md",
    "https://ollama.com/library",
    "https://ollama.com/library/gemma3/tags"
  ]
}
