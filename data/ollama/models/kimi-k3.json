{
  "id": "kimi-k3",
  "provider": "ollama",
  "kind": "chat",
  "attrs": {
    "summary": "Kimi K3 is an open-weight, native multimodal agentic model and our most capable model to date."
  },
  "limits": {
    "context_window": 1000000
  },
  "lists": {
    "features": [
      "function_calling",
      "reasoning",
      "structured_outputs"
    ],
    "input_modalities": [
      "image",
      "text"
    ],
    "output_modalities": [
      "text"
    ]
  },
  "sources": [
    "https://docs.ollama.com/capabilities/structured-outputs.md",
    "https://ollama.com/library",
    "https://ollama.com/library/kimi-k3/tags"
  ]
}
