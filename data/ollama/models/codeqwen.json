{
  "id": "codeqwen",
  "provider": "ollama",
  "kind": "chat",
  "attrs": {
    "summary": "CodeQwen1.5 is a large language model pretrained on a large amount of code data."
  },
  "limits": {
    "context_window": 64000
  },
  "lists": {
    "features": [
      "structured_outputs"
    ],
    "input_modalities": [
      "text"
    ],
    "output_modalities": [
      "text"
    ],
    "parameter_sizes": [
      "7b"
    ]
  },
  "sources": [
    "https://docs.ollama.com/capabilities/structured-outputs.md",
    "https://ollama.com/library",
    "https://ollama.com/library/codeqwen/tags"
  ]
}
