{
  "id": "devstral",
  "provider": "ollama",
  "kind": "chat",
  "attrs": {
    "summary": "Devstral: the best open source model for coding agents"
  },
  "limits": {
    "context_window": 128000
  },
  "lists": {
    "features": [
      "function_calling",
      "structured_outputs"
    ],
    "input_modalities": [
      "text"
    ],
    "output_modalities": [
      "text"
    ],
    "parameter_sizes": [
      "24b"
    ]
  },
  "sources": [
    "https://docs.ollama.com/capabilities/structured-outputs.md",
    "https://ollama.com/library",
    "https://ollama.com/library/devstral/tags"
  ]
}
