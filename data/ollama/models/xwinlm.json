    "output_modalities": [
      "text"
    ],
    "parameter_sizes": [
      "13b",
      "7b"
    ]
  },
  "sources": [
    "https://docs.ollama.com/capabilities/structured-outputs.md",
    "https://ollama.com/library",
    "https://ollama.com/library/xwinlm/tags"
  ]
}
