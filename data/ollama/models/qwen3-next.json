{
  "id": "qwen3-next",
  "provider": "ollama",
  "kind": "chat",
  "attrs": {
    "summary": "The first installment in the Qwen3-Next series with strong performance in terms of both parameter efficiency and inference speed."
  },
  "limits": {
    "context_window": 256000
  },
  "lists": {
    "features": [
      "function_calling",
      "reasoning",
      "structured_outputs"
    ],
    "input_modalities": [
      "text"
    ],
    "output_modalities": [
      "text"
    ],
    "parameter_sizes": [
      "80b"
    ]
  },
  "sources": [
    "https://docs.ollama.com/capabilities/structured-outputs.md",
    "https://ollama.com/library",
    "https://ollama.com/library/qwen3-next/tags"
  ]
}
