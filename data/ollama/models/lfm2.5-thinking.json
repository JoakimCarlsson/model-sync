{
  "id": "lfm2.5-thinking",
  "provider": "ollama",
  "kind": "chat",
  "attrs": {
    "summary": "LFM2.5 is a new family of hybrid models designed for on-device deployment."
  },
  "limits": {
    "context_window": 125000
  },
  "lists": {
    "features": [
      "function_calling",
      "reasoning",
      "structured_outputs"
    ],
    "input_modalities": [
      "text"
    ],
    "output_modalities": [
      "text"
    ],
    "parameter_sizes": [
      "1.2b"
    ]
  },
  "sources": [
    "https://docs.ollama.com/capabilities/structured-outputs.md",
    "https://ollama.com/library",
    "https://ollama.com/library/lfm2.5-thinking/tags"
  ]
}
