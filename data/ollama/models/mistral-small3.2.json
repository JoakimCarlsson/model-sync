{
  "id": "mistral-small3.2",
  "provider": "ollama",
  "kind": "chat",
  "attrs": {
    "summary": "An update to Mistral Small that improves on function calling, instruction following, and less repetition errors."
  },
  "limits": {
    "context_window": 128000
  },
  "lists": {
    "features": [
      "function_calling",
      "structured_outputs"
    ],
    "input_modalities": [
      "image",
      "text"
    ],
    "output_modalities": [
      "text"
    ],
    "parameter_sizes": [
      "24b"
    ]
  },
  "sources": [
    "https://docs.ollama.com/capabilities/structured-outputs.md",
    "https://ollama.com/library",
    "https://ollama.com/library/mistral-small3.2/tags"
  ]
}
