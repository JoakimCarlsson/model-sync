{
  "id": "mistral-small",
  "provider": "ollama",
  "kind": "chat",
  "attrs": {
    "architecture": "llama",
    "default_snapshot": "mistral-small:latest",
    "last_updated": "2025-01-30",
    "license": "Apache License 2.0",
    "open_weights": "true",
    "parameter_count": "23.6B",
    "quantization": "Q4_K_M",
    "summary": "Mistral Small 3 sets a new benchmark in the “small” Large Language Models category below 70B."
  },
  "limits": {
    "context_window": 32000
  },
  "lists": {
    "features": [
      "function_calling",
      "structured_outputs"
    ],
    "input_modalities": [
      "text"
    ],
    "output_modalities": [
      "text"
    ],
    "parameter_sizes": [
      "22b",
      "24b"
    ]
  },
  "sources": [
    "https://docs.ollama.com/capabilities/structured-outputs.md",
    "https://ollama.com/library",
    "https://ollama.com/library/mistral-small/tags",
    "https://ollama.com/library/mistral-small:latest"
  ]
}
