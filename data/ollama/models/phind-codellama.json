{
  "id": "phind-codellama",
  "provider": "ollama",
  "kind": "chat",
  "attrs": {
    "summary": "Code generation model based on Code Llama."
  },
  "limits": {
    "context_window": 16000
  },
  "lists": {
    "features": [
      "structured_outputs"
    ],
    "input_modalities": [
      "text"
    ],
    "output_modalities": [
      "text"
    ],
    "parameter_sizes": [
      "34b"
    ]
  },
  "sources": [
    "https://docs.ollama.com/capabilities/structured-outputs.md",
    "https://ollama.com/library",
    "https://ollama.com/library/phind-codellama/tags"
  ]
}
