{
  "id": "codeup",
  "provider": "ollama",
  "kind": "chat",
  "attrs": {
    "summary": "Great code generation model based on Llama2."
  },
  "limits": {
    "context_window": 4000
  },
  "lists": {
    "features": [
      "structured_outputs"
    ],
    "input_modalities": [
      "text"
    ],
    "output_modalities": [
      "text"
    ],
    "parameter_sizes": [
      "13b"
    ]
  },
  "sources": [
    "https://docs.ollama.com/capabilities/structured-outputs.md",
    "https://ollama.com/library",
    "https://ollama.com/library/codeup/tags"
  ]
}
