{
  "id": "yarn-llama2",
  "provider": "ollama",
  "kind": "chat",
  "attrs": {
    "summary": "An extension of Llama 2 that supports a context of up to 128k tokens."
  },
  "limits": {
    "context_window": 64000
  },
  "lists": {
    "features": [
      "structured_outputs"
    ],
    "input_modalities": [
      "text"
    ],
    "output_modalities": [
      "text"
    ],
    "parameter_sizes": [
      "13b",
      "7b"
    ]
  },
  "sources": [
    "https://docs.ollama.com/capabilities/structured-outputs.md",
    "https://ollama.com/library",
    "https://ollama.com/library/yarn-llama2/tags"
  ]
}
