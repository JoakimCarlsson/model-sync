{
  "id": "mistral",
  "provider": "ollama",
  "kind": "chat",
  "attrs": {
    "summary": "The 7B model released by Mistral AI, updated to version 0.3."
  },
  "limits": {
    "context_window": 32000
  },
  "lists": {
