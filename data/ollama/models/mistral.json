    ],
    "output_modalities": [
      "text"
    ],
    "parameter_sizes": [
      "7b"
    ]
  },
  "sources": [
    "https://docs.ollama.com/capabilities/structured-outputs.md",
    "https://ollama.com/library",
    "https://ollama.com/library/mistral/tags"
  ]
}
