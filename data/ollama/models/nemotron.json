{
  "id": "nemotron",
  "provider": "ollama",
  "kind": "chat",
  "attrs": {
    "summary": "Llama-3.1-Nemotron-70B-Instruct is a large language model customized by NVIDIA to improve the helpfulness of LLM generated responses to user queries."
  },
  "limits": {
    "context_window": 128000
  },
  "lists": {
    "features": [
      "function_calling"
    ],
    "input_modalities": [
      "text"
    ],
    "output_modalities": [
      "text"
    ],
    "parameter_sizes": [
      "70b"
    ]
  },
  "sources": [
    "https://ollama.com/library",
    "https://ollama.com/library/nemotron/tags"
  ]
}
