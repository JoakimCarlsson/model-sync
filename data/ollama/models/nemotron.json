{
  "id": "nemotron",
  "provider": "ollama",
  "kind": "chat",
  "attrs": {
    "architecture": "llama",
    "default_snapshot": "nemotron:latest",
    "last_updated": "2024-10-16",
    "license": "Llama 3.1 Acceptable Use Policy",
    "open_weights": "true",
    "parameter_count": "70.6B",
    "quantization": "Q4_K_M",
    "summary": "Llama-3.1-Nemotron-70B-Instruct is a large language model customized by NVIDIA to improve the helpfulness of LLM generated responses to user queries."
  },
  "limits": {
    "context_window": 128000
  },
  "lists": {
    "features": [
      "function_calling",
      "structured_outputs"
    ],
    "input_modalities": [
      "text"
    ],
    "output_modalities": [
      "text"
    ],
    "parameter_sizes": [
      "70b"
    ]
  },
  "sources": [
    "https://docs.ollama.com/capabilities/structured-outputs.md",
    "https://ollama.com/library",
    "https://ollama.com/library/nemotron/tags",
    "https://ollama.com/library/nemotron:latest"
  ]
}
