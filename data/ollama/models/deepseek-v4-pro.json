{
  "id": "deepseek-v4-pro",
  "provider": "ollama",
  "kind": "chat",
  "attrs": {
    "cloud": "true",
    "summary": "DeepSeek-V4-Pro is a frontier Mixture-of-Experts model with a large context window and three reasoning modes.",
    "usage_level": "extra high",
    "usage_level_rank": "4"
  },
  "limits": {
    "context_window": 1000000
  },
  "lists": {
    "features": [
      "function_calling",
      "reasoning",
      "structured_outputs"
    ],
    "input_modalities": [
      "text"
    ],
    "output_modalities": [
      "text"
    ]
  },
  "sources": [
    "https://docs.ollama.com/capabilities/structured-outputs.md",
    "https://ollama.com/library",
    "https://ollama.com/library/deepseek-v4-pro",
    "https://ollama.com/library/deepseek-v4-pro/tags"
  ]
}
