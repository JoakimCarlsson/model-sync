{
  "id": "bespoke-minicheck",
  "provider": "ollama",
  "kind": "chat",
  "attrs": {
    "summary": "A state-of-the-art fact-checking model developed by Bespoke Labs."
  },
  "limits": {
    "context_window": 32000
  },
  "lists": {
    "features": [
      "structured_outputs"
    ],
    "input_modalities": [
      "text"
    ],
    "output_modalities": [
      "text"
    ],
    "parameter_sizes": [
      "7b"
    ]
  },
  "sources": [
    "https://docs.ollama.com/capabilities/structured-outputs.md",
    "https://ollama.com/library",
    "https://ollama.com/library/bespoke-minicheck/tags"
  ]
}
