  },
  "lists": {
    "features": [
      "function_calling",
      "reasoning",
      "structured_outputs"
    ],
    "input_modalities": [
      "text"
    ],
    "output_modalities": [
      "text"
    ],
    "parameter_sizes": [
      "0.6b",
      "1.7b",
      "14b",
      "235b",
      "30b",
      "32b",
      "4b",
      "8b"
    ]
  },
  "sources": [
    "https://docs.ollama.com/capabilities/structured-outputs.md",
    "https://ollama.com/library",
    "https://ollama.com/library/qwen3/tags"
  ]
}
