{
  "id": "qwen3",
  "provider": "ollama",
  "kind": "chat",
  "attrs": {
    "summary": "Qwen3 is the latest generation of large language models in Qwen series, offering a comprehensive suite of dense and mixture-of-experts (MoE) models."
