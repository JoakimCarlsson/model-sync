{
  "id": "nemotron-mini",
  "provider": "ollama",
  "kind": "chat",
  "attrs": {
    "summary": "A commercial-friendly small language model by NVIDIA optimized for roleplay, RAG QA, and function calling."
  },
  "limits": {
    "context_window": 4000
  },
  "lists": {
    "features": [
      "function_calling",
      "structured_outputs"
    ],
    "input_modalities": [
      "text"
    ],
    "output_modalities": [
      "text"
    ],
    "parameter_sizes": [
      "4b"
    ]
  },
  "sources": [
    "https://docs.ollama.com/capabilities/structured-outputs.md",
    "https://ollama.com/library",
    "https://ollama.com/library/nemotron-mini/tags"
  ]
}
