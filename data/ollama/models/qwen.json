{
  "id": "qwen",
  "provider": "ollama",
  "kind": "chat",
  "attrs": {
    "summary": "Qwen 1.5 is a series of large language models by Alibaba Cloud spanning from 0.5B to 110B parameters"
  },
  "limits": {
    "context_window": 32000
  },
  "lists": {
    "features": [
      "structured_outputs"
    ],
    "input_modalities": [
      "text"
    ],
    "output_modalities": [
      "text"
    ],
    "parameter_sizes": [
      "0.5b",
      "1.8b",
      "110b",
      "14b",
      "32b",
      "4b",
      "72b",
      "7b"
    ]
  },
  "sources": [
    "https://docs.ollama.com/capabilities/structured-outputs.md",
    "https://ollama.com/library",
    "https://ollama.com/library/qwen/tags"
  ]
}
