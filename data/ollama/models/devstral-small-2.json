{
  "id": "devstral-small-2",
  "provider": "ollama",
  "kind": "chat",
  "attrs": {
    "summary": "24B model that excels at using tools to explore codebases, editing multiple files and power software engineering agents."
  },
  "limits": {
    "context_window": 384000
  },
  "lists": {
    "features": [
      "function_calling",
      "structured_outputs"
    ],
    "input_modalities": [
      "image",
      "text"
    ],
    "output_modalities": [
      "text"
    ],
    "parameter_sizes": [
      "24b"
    ]
  },
  "sources": [
    "https://docs.ollama.com/capabilities/structured-outputs.md",
    "https://ollama.com/library",
    "https://ollama.com/library/devstral-small-2/tags"
  ]
}
