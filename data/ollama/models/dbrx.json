{
  "id": "dbrx",
  "provider": "ollama",
  "kind": "chat",
  "attrs": {
    "summary": "DBRX is an open, general-purpose LLM created by Databricks."
  },
  "limits": {
    "context_window": 32000
  },
  "lists": {
    "features": [
      "structured_outputs"
    ],
    "input_modalities": [
      "text"
    ],
    "output_modalities": [
      "text"
    ],
    "parameter_sizes": [
      "132b"
    ]
  },
  "sources": [
    "https://docs.ollama.com/capabilities/structured-outputs.md",
    "https://ollama.com/library",
    "https://ollama.com/library/dbrx/tags"
  ]
}
