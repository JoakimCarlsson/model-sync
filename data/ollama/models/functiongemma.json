{
  "id": "functiongemma",
  "provider": "ollama",
  "kind": "chat",
  "attrs": {
    "summary": "FunctionGemma is a specialized version of Google&#39;s Gemma 3 270M model fine-tuned explicitly for function calling."
  },
  "limits": {
    "context_window": 32000
  },
  "lists": {
    "features": [
      "function_calling",
      "structured_outputs"
    ],
    "input_modalities": [
      "text"
    ],
    "output_modalities": [
      "text"
    ],
    "parameter_sizes": [
      "270m"
    ]
  },
  "sources": [
    "https://docs.ollama.com/capabilities/structured-outputs.md",
    "https://ollama.com/library",
    "https://ollama.com/library/functiongemma/tags"
  ]
}
