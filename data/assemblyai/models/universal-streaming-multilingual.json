{
  "id": "universal-streaming-multilingual",
  "provider": "assemblyai",
  "name": "Universal-Streaming Multilingual",
  "kind": "transcription",
  "prices": [
    {
      "metric": "session",
      "unit": "per_hour",
      "amount": 0.15,
      "currency": "USD",
      "dims": {
        "mode": "streaming"
      }
    }
  ],
  "attrs": {
    "api_identifier": "universal-streaming-multilingual",
    "mode": "streaming",
    "volume_discounts": "available"
  },
  "limits": {
    "language_count": 6,
    "max_keyterms": 100
  },
  "lists": {
    "features": [
      "keyterm_prompting",
      "language_detection",
      "partial_transcripts",
      "realtime"
    ],
    "input_modalities": [
      "audio"
    ],
    "languages": [
      "de",
      "en",
      "es",
      "fr",
      "it",
      "pt"
    ],
    "output_modalities": [
      "text"
    ]
  },
  "sources": [
    "https://www.assemblyai.com/docs/getting-started/models.md",
    "https://www.assemblyai.com/docs/streaming/select-the-speech-model.md"
  ]
}
