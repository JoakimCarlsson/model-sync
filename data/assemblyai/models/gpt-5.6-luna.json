{
  "id": "gpt-5.6-luna",
  "provider": "assemblyai",
  "name": "GPT-5.6 Luna",
  "kind": "chat",
  "prices": [
    {
      "metric": "cache_write_tokens",
      "unit": "per_1m_tokens",
      "amount": 1.25,
      "currency": "USD"
    },
    {
      "metric": "cached_input_tokens",
      "unit": "per_1m_tokens",
      "amount": 0.1,
      "currency": "USD"
    },
    {
      "metric": "input_tokens",
      "unit": "per_1m_tokens",
      "amount": 1,
      "currency": "USD"
    },
    {
      "metric": "output_tokens",
      "unit": "per_1m_tokens",
      "amount": 6,
      "currency": "USD"
    }
  ],
  "attrs": {
    "api_identifier": "gpt-5.6-luna",
    "regional_surcharge": "+10%"
  },
  "limits": {
    "context_window": 270000,
    "requests_per_minute_paid": 30
  },
  "lists": {
    "endpoints": [
      "https://llm-gateway.assemblyai.com/v1/chat/completions"
    ],
    "features": [
      "function_calling",
      "streaming",
      "structured_outputs"
    ],
    "input_modalities": [
      "text"
    ],
    "output_modalities": [
      "text"
    ],
    "parameters": [
      "max_tokens",
      "response_format",
      "stream",
      "tool_choice",
      "tools"
    ]
  },
  "sources": [
    "https://www.assemblyai.com/docs/llm-gateway/api-reference/create-chat-completion.md",
    "https://www.assemblyai.com/docs/llm-gateway/available-models.md",
    "https://www.assemblyai.com/docs/llm-gateway/rate-limits.md"
  ]
}
