{
  "id": "zai-org/GLM-5.2",
  "provider": "together",
  "name": "GLM-5.2",
  "kind": "chat",
  "prices": [
    {
      "metric": "cached_input_tokens",
      "unit": "per_1m_tokens",
      "amount": 0.26,
      "currency": "USD"
    },
    {
      "metric": "input_tokens",
      "unit": "per_1m_tokens",
      "amount": 1.4,
      "currency": "USD"
    },
    {
      "metric": "output_tokens",
      "unit": "per_1m_tokens",
      "amount": 4.4,
      "currency": "USD"
    }
  ],
  "attrs": {
    "author": "Z.ai",
    "quantization": "FP4"
  },
  "limits": {
    "context_window": 512000,
    "max_output_tokens": 128000
  },
  "lists": {
    "features": [
      "function_calling",
      "json_mode",
      "reasoning",
      "structured_outputs"
    ],
    "input_modalities": [
      "text"
    ],
    "output_modalities": [
      "text"
    ]
  },
  "sources": [
    "https://docs.together.ai/docs/glm-5.2-quickstart.md",
    "https://docs.together.ai/docs/serverless-models.md",
    "https://www.together.ai/models/glm-52"
  ]
}
