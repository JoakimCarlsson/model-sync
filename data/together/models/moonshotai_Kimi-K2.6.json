{
  "id": "moonshotai/Kimi-K2.6",
  "provider": "together",
  "name": "Kimi K2.6",
  "kind": "chat",
  "prices": [
    {
      "metric": "cached_input_tokens",
      "unit": "per_1m_tokens",
      "amount": 0.2,
      "currency": "USD"
    },
    {
      "metric": "input_tokens",
      "unit": "per_1m_tokens",
      "amount": 1.2,
      "currency": "USD"
    },
    {
      "metric": "output_tokens",
      "unit": "per_1m_tokens",
      "amount": 4.5,
      "currency": "USD"
    }
  ],
  "attrs": {
    "author": "Moonshot",
    "quantization": "FP4",
    "reasoning_mode": "hybrid (on by default)"
  },
  "limits": {
    "context_window": 262144
  },
  "lists": {
    "features": [
      "function_calling",
      "json_mode",
      "reasoning",
      "structured_outputs"
    ],
    "input_modalities": [
      "image",
      "text",
      "video"
    ],
    "output_modalities": [
      "text"
    ]
  },
  "sources": [
    "https://docs.together.ai/docs/inference/chat/reasoning.md",
    "https://docs.together.ai/docs/serverless-models.md",
    "https://www.together.ai/models/kimi-k26"
  ]
}
