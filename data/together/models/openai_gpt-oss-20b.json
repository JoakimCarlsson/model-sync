{
  "id": "openai/gpt-oss-20b",
  "provider": "together",
  "name": "GPT-OSS 20B",
  "kind": "chat",
  "prices": [
    {
      "metric": "input_tokens",
      "unit": "per_1m_tokens",
      "amount": 0.05,
      "currency": "USD"
    },
    {
      "metric": "output_tokens",
      "unit": "per_1m_tokens",
      "amount": 0.2,
      "currency": "USD"
    }
  ],
  "attrs": {
    "author": "OpenAI",
    "quantization": "MXFP4",
    "reasoning_mode": "adjustable effort"
  },
  "limits": {
    "context_window": 128000
  },
  "lists": {
    "features": [
      "function_calling",
      "json_mode",
      "reasoning",
      "structured_outputs"
    ],
    "input_modalities": [
      "text"
    ],
    "output_modalities": [
      "text"
    ]
  },
  "sources": [
    "https://docs.together.ai/docs/inference/chat/reasoning.md",
    "https://docs.together.ai/docs/serverless-models.md",
    "https://www.together.ai/models/gpt-oss-20b"
  ]
}
