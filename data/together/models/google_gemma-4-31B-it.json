{
  "id": "google/gemma-4-31B-it",
  "provider": "together",
  "name": "Gemma 4 31B Instruct",
  "kind": "chat",
  "prices": [
    {
      "metric": "input_tokens",
      "unit": "per_1m_tokens",
      "amount": 0.39,
      "currency": "USD"
    },
    {
      "metric": "output_tokens",
      "unit": "per_1m_tokens",
      "amount": 0.97,
      "currency": "USD"
    }
  ],
  "attrs": {
    "author": "Google",
    "quantization": "FP8"
  },
  "limits": {
    "context_window": 262144
  },
  "lists": {
    "features": [
      "function_calling",
      "structured_outputs"
    ]
  },
  "sources": [
    "https://docs.together.ai/docs/serverless-models.md"
  ]
}
