{
  "id": "openai/gpt-4o-mini",
  "provider": "openrouter",
  "name": "OpenAI: GPT-4o-mini",
  "kind": "chat",
  "prices": [
    {
      "metric": "cached_input_tokens",
      "unit": "per_1m_tokens",
      "amount": 0.075,
      "currency": "USD"
    },
    {
      "metric": "input_tokens",
      "unit": "per_1m_tokens",
      "amount": 0.15,
      "currency": "USD"
    },
    {
      "metric": "output_tokens",
      "unit": "per_1m_tokens",
      "amount": 0.6,
      "currency": "USD"
    }
  ],
  "attrs": {
    "author": "openai",
    "canonical_slug": "openai/gpt-4o-mini",
    "is_moderated": "true",
    "knowledge_cutoff": "2023-10-31",
    "released": "2024-07-18",
    "summary": "GPT-4o mini is OpenAI's newest model after [GPT-4 Omni](/models/openai/gpt-4o), supporting both text and image inputs with text outputs.",
    "tokenizer": "GPT"
  },
  "limits": {
    "context_window": 128000,
    "max_output_tokens": 16384,
    "top_provider_context_window": 128000
  },
  "lists": {
    "features": [
      "function_calling",
      "json_mode",
      "structured_outputs"
    ],
    "input_modalities": [
      "file",
      "image",
      "text"
    ],
    "output_modalities": [
      "text"
    ],
    "parameters": [
      "frequency_penalty",
      "logit_bias",
      "logprobs",
      "max_completion_tokens",
      "max_tokens",
      "prediction",
      "presence_penalty",
      "response_format",
      "seed",
      "stop",
      "structured_outputs",
      "temperature",
      "tool_choice",
      "tools",
      "top_logprobs",
      "top_p",
      "web_search_options"
    ]
  },
  "sources": [
    "https://openrouter.ai/api/v1/models"
  ]
}
