{
  "id": "openai/gpt-4o:batch",
  "provider": "openrouter",
  "name": "OpenAI: GPT-4o (batch)",
  "kind": "chat",
  "prices": [
    {
      "metric": "cached_input_tokens",
      "unit": "per_1m_tokens",
      "amount": 0.625,
      "currency": "USD"
    },
    {
      "metric": "input_tokens",
      "unit": "per_1m_tokens",
      "amount": 1.25,
      "currency": "USD"
    },
    {
      "metric": "output_tokens",
      "unit": "per_1m_tokens",
      "amount": 5,
      "currency": "USD"
    },
    {
      "metric": "tool_call",
      "unit": "per_1k_calls",
      "amount": 10,
      "currency": "USD"
    }
  ],
  "attrs": {
    "author": "openai",
    "canonical_slug": "openai/gpt-4o",
    "is_moderated": "true",
    "knowledge_cutoff": "2023-10-31",
    "released": "2024-05-13",
    "summary": "GPT-4o (\"o\" for \"omni\") is OpenAI's latest AI model, supporting both text and image inputs with text outputs.",
    "tokenizer": "GPT"
  },
  "limits": {
    "context_window": 128000,
    "max_output_tokens": 16384,
    "top_provider_context_window": 128000
  },
  "lists": {
    "features": [
      "frequency_penalty",
      "logit_bias",
      "logprobs",
      "max_tokens",
      "prediction",
      "presence_penalty",
      "response_format",
      "seed",
      "stop",
      "structured_outputs",
      "temperature",
      "tool_choice",
      "tools",
      "top_logprobs",
      "top_p",
      "web_search_options"
    ],
    "input_modalities": [
      "file",
      "image",
      "text"
    ],
    "output_modalities": [
      "text"
    ]
  },
  "sources": [
    "https://openrouter.ai/api/v1/models"
  ]
}
