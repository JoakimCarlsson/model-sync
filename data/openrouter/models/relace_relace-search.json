{
  "id": "relace/relace-search",
  "provider": "openrouter",
  "name": "Relace: Relace Search",
  "kind": "chat",
  "prices": [
    {
      "metric": "input_tokens",
      "unit": "per_1m_tokens",
      "amount": 1,
      "currency": "USD"
    },
    {
      "metric": "output_tokens",
      "unit": "per_1m_tokens",
      "amount": 3,
      "currency": "USD"
    }
  ],
  "attrs": {
    "author": "relace",
    "canonical_slug": "relace/relace-search-20251208",
    "released": "2025-12-08",
    "summary": "The relace-search model uses 4-12 `view_file` and `grep` tools in parallel to explore a codebase and return relevant files to the user request.",
    "tokenizer": "Other"
  },
  "limits": {
    "context_window": 256000,
    "max_output_tokens": 128000,
    "top_provider_context_window": 256000
  },
  "lists": {
    "features": [
      "function_calling",
      "json_mode",
      "structured_outputs"
    ],
    "input_modalities": [
      "text"
    ],
    "output_modalities": [
      "text"
    ],
    "parameters": [
      "max_tokens",
      "response_format",
      "seed",
      "stop",
      "temperature",
      "tool_choice",
      "tools",
      "top_p"
    ]
  },
  "sources": [
    "https://openrouter.ai/api/v1/models"
  ]
}
