{
  "id": "~google/gemini-flash-latest",
  "provider": "openrouter",
  "name": "Google Gemini Flash Latest",
  "kind": "chat",
  "prices": [
    {
      "metric": "audio_input",
      "unit": "per_1m_tokens",
      "amount": 1.5,
      "currency": "USD"
    },
    {
      "metric": "cache_write_tokens",
      "unit": "per_1m_tokens",
      "amount": 0.0833333333333333,
      "currency": "USD"
    },
    {
      "metric": "cached_audio_input",
      "unit": "per_1m_tokens",
      "amount": 0.15,
      "currency": "USD"
    },
    {
      "metric": "cached_input_tokens",
      "unit": "per_1m_tokens",
      "amount": 0.15,
      "currency": "USD"
    },
    {
      "metric": "image_input",
      "unit": "per_image",
      "amount": 0.0000015,
      "currency": "USD"
    },
    {
      "metric": "input_tokens",
      "unit": "per_1m_tokens",
      "amount": 1.5,
      "currency": "USD"
    },
    {
      "metric": "output_tokens",
      "unit": "per_1m_tokens",
      "amount": 7.5,
      "currency": "USD"
    },
    {
      "metric": "reasoning_tokens",
      "unit": "per_1m_tokens",
      "amount": 7.5,
      "currency": "USD"
    },
    {
      "metric": "tool_call",
      "unit": "per_1k_calls",
      "amount": 14,
      "currency": "USD"
    }
  ],
  "attrs": {
    "author": "~google",
    "canonical_slug": "~google/gemini-flash-latest",
    "reasoning_mandatory": "true",
    "released": "2026-04-27",
    "summary": "This model always redirects to the latest model in the Google Gemini Flash family.",
    "tokenizer": "Router"
  },
  "limits": {
    "context_window": 1048576,
    "max_output_tokens": 65536,
    "top_provider_context_window": 1048576
  },
  "lists": {
    "features": [
      "include_reasoning",
      "max_tokens",
      "reasoning",
      "reasoning_effort",
      "response_format",
      "seed",
      "stop",
      "structured_outputs",
      "temperature",
      "tool_choice",
      "tools",
      "top_p"
    ],
    "input_modalities": [
      "audio",
      "file",
      "image",
      "text",
      "video"
    ],
    "output_modalities": [
      "text"
    ]
  },
  "sources": [
    "https://openrouter.ai/api/v1/models"
  ]
}
