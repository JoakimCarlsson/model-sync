{
  "id": "openai/gpt-4",
  "provider": "openrouter",
  "name": "OpenAI: GPT-4",
  "kind": "chat",
  "prices": [
    {
      "metric": "input_tokens",
      "unit": "per_1m_tokens",
      "amount": 30,
      "currency": "USD"
    },
    {
      "metric": "output_tokens",
      "unit": "per_1m_tokens",
      "amount": 60,
      "currency": "USD"
    }
  ],
  "attrs": {
    "author": "openai",
    "canonical_slug": "openai/gpt-4",
    "knowledge_cutoff": "2021-09-30",
    "released": "2023-05-28",
    "summary": "OpenAI's flagship model, GPT-4 is a large-scale multimodal language model capable of solving difficult problems with greater accuracy than previous models due to its broader general knowledge and advanced reasoning...",
    "tokenizer": "GPT"
  },
  "limits": {
    "context_window": 8191,
    "max_output_tokens": 4096,
    "top_provider_context_window": 8191
  },
  "lists": {
    "features": [
      "frequency_penalty",
      "logit_bias",
      "logprobs",
      "max_completion_tokens",
      "max_tokens",
      "presence_penalty",
      "response_format",
      "seed",
      "stop",
      "structured_outputs",
      "temperature",
      "tool_choice",
      "tools",
      "top_logprobs",
      "top_p"
    ],
    "input_modalities": [
      "text"
    ],
    "output_modalities": [
      "text"
    ]
  },
  "sources": [
    "https://openrouter.ai/api/v1/models"
  ]
}
