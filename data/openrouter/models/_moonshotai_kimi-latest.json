{
  "id": "~moonshotai/kimi-latest",
  "provider": "openrouter",
  "name": "MoonshotAI Kimi Latest",
  "kind": "chat",
  "prices": [
    {
      "metric": "cached_input_tokens",
      "unit": "per_1m_tokens",
      "amount": 0.29,
      "currency": "USD"
    },
    {
      "metric": "input_tokens",
      "unit": "per_1m_tokens",
      "amount": 2.6,
      "currency": "USD"
    },
    {
      "metric": "output_tokens",
      "unit": "per_1m_tokens",
      "amount": 13,
      "currency": "USD"
    }
  ],
  "attrs": {
    "alias_target": "moonshotai/kimi-k3",
    "author": "~moonshotai",
    "canonical_slug": "~moonshotai/kimi-latest",
    "default_top_p": "0.95",
    "modality": "text+image+video->text",
    "reasoning_default_effort": "max",
    "reasoning_default_enabled": "true",
    "release_date": "2026-04-27",
    "summary": "This model always redirects to the latest model in the MoonshotAI Kimi family.",
    "tokenizer": "Router"
  },
  "limits": {
    "context_window": 1048576,
    "max_output_tokens": 974842,
    "top_provider_context_window": 974842
  },
  "lists": {
    "features": [
      "function_calling",
      "json_mode",
      "prompt_caching",
      "reasoning",
      "structured_outputs"
    ],
    "input_modalities": [
      "image",
      "text",
      "video"
    ],
    "output_modalities": [
      "text"
    ],
    "parameters": [
      "frequency_penalty",
      "include_reasoning",
      "logit_bias",
      "logprobs",
      "max_tokens",
      "min_p",
      "presence_penalty",
      "reasoning",
      "reasoning_effort",
      "repetition_penalty",
      "response_format",
      "seed",
      "stop",
      "structured_outputs",
      "temperature",
      "tool_choice",
      "tools",
      "top_k",
      "top_logprobs",
      "top_p"
    ],
    "reasoning_efforts": [
      "high",
      "low",
      "max"
    ]
  },
  "sources": [
    "https://openrouter.ai/api/v1/models/~moonshotai/kimi-latest/endpoints",
    "https://openrouter.ai/api/v1/models?output_modalities=all"
  ]
}
