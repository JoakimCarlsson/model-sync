    },
    {
      "metric": "input_tokens",
      "unit": "per_1m_tokens",
      "amount": 2.5,
      "currency": "USD"
    },
    {
      "metric": "output_tokens",
      "unit": "per_1m_tokens",
      "amount": 12.5,
      "currency": "USD"
    }
  ],
  "attrs": {
    "author": "amazon",
    "canonical_slug": "amazon/nova-premier-v1",
    "is_moderated": "true",
    "released": "2025-10-31",
