{
  "id": "openai/o1-pro:batch",
  "provider": "openrouter",
  "name": "OpenAI: o1-pro (batch)",
  "kind": "chat",
  "prices": [
    {
      "metric": "input_tokens",
      "unit": "per_1m_tokens",
      "amount": 75,
      "currency": "USD"
    },
    {
      "metric": "output_tokens",
      "unit": "per_1m_tokens",
      "amount": 300,
      "currency": "USD"
    },
    {
      "metric": "tool_call",
      "unit": "per_1k_calls",
      "amount": 10,
      "currency": "USD"
    }
  ],
  "attrs": {
    "author": "openai",
    "canonical_slug": "openai/o1-pro",
    "is_moderated": "true",
    "knowledge_cutoff": "2023-10-31",
    "released": "2025-03-19",
    "summary": "The o1 series of models are trained with reinforcement learning to think before they answer and perform complex reasoning.",
    "tokenizer": "GPT"
  },
  "limits": {
    "context_window": 200000,
    "max_output_tokens": 100000,
    "top_provider_context_window": 200000
  },
  "lists": {
    "features": [
      "json_mode",
      "reasoning",
      "structured_outputs"
    ],
    "input_modalities": [
      "file",
      "image",
      "text"
    ],
    "output_modalities": [
      "text"
    ],
    "parameters": [
      "include_reasoning",
      "max_tokens",
      "reasoning",
      "response_format",
      "seed",
      "structured_outputs"
    ]
  },
  "sources": [
    "https://openrouter.ai/api/v1/models"
  ]
}
