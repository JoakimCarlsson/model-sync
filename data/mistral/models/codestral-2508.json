{
  "id": "codestral-2508",
  "provider": "mistral",
  "name": "Codestral",
  "kind": "chat",
  "prices": [
    {
      "metric": "input_tokens",
      "unit": "per_1m_tokens",
      "amount": 0.3,
      "currency": "USD"
