      "metric": "output_tokens",
      "unit": "per_1m_tokens",
      "amount": 0.9,
      "currency": "USD"
    }
  ],
  "attrs": {
    "distribution": "premier",
    "open_weights": "false",
    "release_date": "2025-07-30",
    "state": "active",
    "summary": "Our cutting-edge language model for code completion released end of July 2025, Codestral specializes in low-latency, high-frequency tasks such as fill-in-the-middle (FIM) and code generation.",
