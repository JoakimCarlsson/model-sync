{
  "id": "groq/compound-mini",
  "provider": "groq",
  "name": "Compound Mini",
  "kind": "chat",
  "attrs": {
    "is_system": "true",
    "state": "production",
    "tokens_per_second": "450"
  },
  "limits": {
    "context_window": 131072,
    "max_output_tokens": 8192,
    "requests_per_minute": 200,
    "tokens_per_minute": 200000
  },
  "lists": {
    "features": [
      "code_execution",
      "json_mode",
      "structured_outputs",
      "visit_website",
      "web_search",
      "wolfram_alpha"
    ],
    "input_modalities": [
      "text"
    ],
    "output_modalities": [
      "text"
    ]
  },
  "notes": [
    "Final pricing depends on which underlying models and tools are used for your specific query."
  ],
  "sources": [
    "https://console.groq.com/docs/compound/systems/compound-mini.md",
    "https://console.groq.com/docs/models.md"
  ]
}
