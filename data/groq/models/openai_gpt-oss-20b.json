{
  "id": "openai/gpt-oss-20b",
  "provider": "groq",
  "name": "GPT OSS 20B",
  "kind": "chat",
  "prices": [
    {
      "metric": "input_tokens",
      "unit": "per_1m_tokens",
      "amount": 0.075,
      "currency": "USD"
    },
    {
      "metric": "output_tokens",
      "unit": "per_1m_tokens",
      "amount": 0.3,
      "currency": "USD"
    }
  ],
  "attrs": {
    "state": "production",
    "tokens_per_second": "1000"
  },
  "limits": {
    "context_window": 131072,
    "max_output_tokens": 65536,
    "requests_per_minute": 1000,
    "tokens_per_minute": 250000
  },
  "sources": [
    "https://console.groq.com/docs/models.md"
  ]
}
